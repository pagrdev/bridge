{
  "name": "@pagr/cli",
  "version": "0.2.0",
  "description": "pagr \u2014 connect your Mac's Claude Code and Codex sessions to Pagr",
  "keywords": [
    "pagr",
    "cli",
    "claude-code",
    "codex",
    "macos"
  ],
  "license": "Apache-2.0",
  "author": "Stagberry Labs LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pagrdev/bridge.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/pagrdev/bridge/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/pagrdev/bridge/issues"
  },
  "type": "module",
  "bin": {
    "pagr": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/channel-server.mjs dist/channel-server.mjs && chmod +x dist/bin.js dist/channel-server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@pagr/bridge-adapter-claude": "workspace:*",
    "@pagr/bridge-adapter-codex": "workspace:*",
    "@pagr/bridge-core": "workspace:*",
    "@pagr/protocol": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@pagr/claude-channel": "workspace:*"
  }
}
