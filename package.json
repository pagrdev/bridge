{
  "name": "pagr-bridge",
  "private": true,
  "version": "0.1.0",
  "description": "Pagr bridge — open-source macOS daemon that lets Pagr's cloud drive your local Claude Code and Codex sessions through typed, signed commands. No remote shell.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "gate": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^22.10.0",
    "turbo": "^2.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "vite": "^7.3.0"
    }
  }
}
