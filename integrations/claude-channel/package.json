{
  "name": "@pagr/claude-channel",
  "version": "0.1.0",
  "description": "Pagr channel server for Claude Code — pushes phone messages into a running Claude Code session and relays permission prompts. Research preview, dev-flag only (ADR 0001 `approved-channel`).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stagberry-labs/pagr-bridge.git",
    "directory": "integrations/claude-channel"
  },
  "homepage": "https://github.com/stagberry-labs/pagr-bridge/tree/main/integrations/claude-channel#readme",
  "bugs": {
    "url": "https://github.com/stagberry-labs/pagr-bridge/issues"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pagr/bridge-adapter-claude": "workspace:*",
    "@pagr/bridge-core": "workspace:*",
    "zod": "^3.25.0"
  }
}
