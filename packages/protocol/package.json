{
  "name": "@pagr/protocol",
  "version": "0.1.0",
  "description": "Pagr device protocol — typed, versioned schemas for cloud→bridge commands and bridge→cloud events. Public so anyone can audit exactly what the bridge can be asked to do.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pagrdev/bridge.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/pagrdev/bridge/tree/main/packages/protocol#readme",
  "bugs": {
    "url": "https://github.com/pagrdev/bridge/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/__tests__",
    "!dist/**/__fixtures__",
    "!dist/testUtil.*",
    "!dist/testFixtures.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.25.0"
  }
}
