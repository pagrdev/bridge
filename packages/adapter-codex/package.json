{
  "name": "@pagr/bridge-adapter-codex",
  "version": "0.1.0",
  "description": "Codex adapter for the Pagr bridge — drives `codex app-server` threads and relays their approval requests as typed approvals.",
  "keywords": [
    "pagr",
    "bridge",
    "adapter",
    "codex"
  ],
  "license": "Apache-2.0",
  "author": "Stagberry Labs LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pagrdev/bridge.git",
    "directory": "packages/adapter-codex"
  },
  "homepage": "https://github.com/pagrdev/bridge/tree/main/packages/adapter-codex#readme",
  "bugs": {
    "url": "https://github.com/pagrdev/bridge/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pagr/bridge-core": "workspace:*",
    "@pagr/protocol": "workspace:*",
    "zod": "^3.25.0"
  }
}
