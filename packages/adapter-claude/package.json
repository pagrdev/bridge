{
  "name": "@pagr/bridge-adapter-claude",
  "version": "0.2.0",
  "description": "Claude Code adapter for the Pagr bridge — drives headless `claude` sessions and relays their permission prompts as typed approvals.",
  "keywords": [
    "pagr",
    "bridge",
    "adapter",
    "claude-code"
  ],
  "license": "Apache-2.0",
  "author": "Stagberry Labs LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pagrdev/bridge.git",
    "directory": "packages/adapter-claude"
  },
  "homepage": "https://github.com/pagrdev/bridge/tree/main/packages/adapter-claude#readme",
  "bugs": {
    "url": "https://github.com/pagrdev/bridge/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/hooks && cp src/hooks/permission.mjs dist/hooks/permission.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pagr/bridge-core": "workspace:*",
    "@pagr/protocol": "workspace:*",
    "zod": "^3.25.0"
  }
}
