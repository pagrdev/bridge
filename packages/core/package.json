{
  "name": "@pagr/bridge-core",
  "version": "0.1.0",
  "description": "Pagr bridge core — the local daemon, IPC server, signed-command guard, gateway transport and project registry behind the `pagr` CLI.",
  "keywords": [
    "pagr",
    "bridge",
    "daemon",
    "claude-code",
    "codex"
  ],
  "license": "Apache-2.0",
  "author": "Stagberry Labs LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pagrdev/bridge.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/pagrdev/bridge/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/pagrdev/bridge/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/__tests__",
    "!dist/**/__fixtures__",
    "!dist/testUtil.*",
    "!dist/testFixtures.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@pagr/protocol": "workspace:*",
    "ws": "^8.21.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
